# In Coolify als Umgebungsvariablen setzen (niemals committen). Lokal: als .env.local kopieren.
# NEXT_PUBLIC_* werden beim Build eingebacken: nach Änderung neu deployen.

# Domain ohne Schrägstrich am Ende (Vorschau: Test-Domain, live: endgültige Domain)
NEXT_PUBLIC_SITE_URL=https://www.joana-kort.de
# Nur auf der echten Domain "true" setzen. Sonst noindex + robots.txt sperrt alles (Vorschau)
NEXT_PUBLIC_INDEXABLE=false
# Search Console (HTML-Tag): nur der content-Wert
NEXT_PUBLIC_GSC_VERIFICATION=

# Stammdaten (Standardwerte in lib/site.ts)
NEXT_PUBLIC_EMAIL=kontakt@joana-kort.de
# Telefon ("Anrufen" im Header, Menü, Footer, Impressum). Leer = Standard aus lib/site.ts (+49 1578 2327179)
NEXT_PUBLIC_PHONE=
# WhatsApp-Nummer, nur falls abweichend vom Telefon (z. B. 491701234567). Leer = dieselbe Nummer wie NEXT_PUBLIC_PHONE
NEXT_PUBLIC_WHATSAPP=
# Ladungsfähige Anschrift für Impressum und Datenschutz (Pflicht vor dem Go-live)
NEXT_PUBLIC_STREET=
NEXT_PUBLIC_ZIP=51643
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=

# Google-Unternehmensprofil (sobald angelegt). Bewertungen selbst stehen in lib/content/reviews.ts
NEXT_PUBLIC_GOOGLE_PROFILE_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Online-Terminbuchung (Calendly, Cal.com o. Ä.). Leer = Anfrage über das eigene Formular
NEXT_PUBLIC_BOOKING_URL=

# E-Mail-Versand der Formulare (Erstgespräch, Warteliste)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Antworten von Interessenten auf Bestätigungsmails (Standard: NEXT_PUBLIC_EMAIL)
SMTP_REPLY_TO=
# Empfängerin der Anfragen (Standard: NEXT_PUBLIC_EMAIL)
RECIPIENT=
# Bestätigungs-E-Mail an Interessenten (Standard an). "false" = aus
CONFIRMATION_MAIL=true
# Optional: jede Anfrage zusätzlich als JSON an Make/n8n/CRM
LEAD_WEBHOOK_URL=

# Speicherort der Anfragen (JSONL). In Coolify persistentes Volume auf /app/data mounten
DATA_DIR=/app/data
